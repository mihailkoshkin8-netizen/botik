# ================== DB ==================
async def init_db():
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("""
        CREATE TABLE IF NOT EXISTS users (
            tg_id INTEGER PRIMARY KEY,
            username TEXT,
            hwid TEXT UNIQUE,
            license_until TEXT,
            blocked_until TEXT,
            block_reason TEXT,
            tokens INTEGER DEFAULT 300,
            token_limit INTEGER DEFAULT 300,
            token_limit_until TEXT,
            last_reset TEXT,
            created_at TEXT
        )""")
        await db.execute("""
        CREATE TABLE IF NOT EXISTS keys (
            key TEXT PRIMARY KEY,
            activations_left INTEGER,
            duration_hours INTEGER,
            created_at TEXT
        )""")
        await db.commit()


async def db_exec(q, p=()):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute(q, p)
        await db.commit()


async def db_fetch(q, p=()):
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        async with db.execute(q, p) as cur:
            row = await cur.fetchone()
            return dict(row) if row else None


async def db_fetchall(q, p=()):
    async with aiosqlite.connect(DB_PATH) as db:
        db.row_factory = aiosqlite.Row
        async with db.execute(q, p) as cur:
            return [dict(r) for r in await cur.fetchall()]


# ================== HELPERS ==================
def is_admin(user) -> bool:
    uname = (user.username or "").lower().lstrip("@")
    return user.id == ADMIN_ID and uname == ADMIN_USERNAME.lower()


def generate_hwid(tg_id: int) -> str:
    return hashlib.sha256(f"{tg_id}-{secrets.token_hex(16)}".encode()).hexdigest()[:16]


def gen_key() -> str:
    return "KEY-" + "".join(secrets.choice("ABCDEFGHJKLMNPQRSTUVWXYZ23456789") for _ in range(16))


def parse_dt(s):
    if not s:
        return None
    try:
        return datetime.fromisoformat(s)
    except Exception:
        return None


def license_active(user) -> bool:
    dt = parse_dt(user.get("license_until"))
    return bool(dt and dt > datetime.now(timezone.utc))


def is_blocked(user):
    dt = parse_dt(user.get("blocked_until"))
    if not dt:
        return False
    return dt > datetime.now(timezone.utc)


async def get_user(tg_id):
    return await db_fetch("SELECT * FROM users WHERE tg_id=?", (tg_id,))


async def get_user_by_hwid(hwid):
    return await db_fetch("SELECT * FROM users WHERE hwid=?", (hwid,))


async def ensure_user(msg: Message):
    """Создаёт/обновляет пользователя. Возвращает (user, is_admin_flag)."""
    u = await get_user(msg.from_user.id)
    if not u:
        hwid = generate_hwid(msg.from_user.id)
        await db_exec(
            "INSERT INTO users(tg_id, username, hwid, tokens, token_limit, created_at, last_reset) VALUES(?,?,?,?,?,?,?)",
            (msg.from_user.id, msg.from_user.username or "", hwid,
             DEFAULT_TOKEN_LIMIT, DEFAULT_TOKEN_LIMIT,
             datetime.now(timezone.utc).isoformat(),
             datetime.now(MSK).date().isoformat()),
        )
        u = await get_user(msg.from_user.id)
    # update username
    if (u["username"] or "") != (msg.from_user.username or ""):
        await db_exec("UPDATE users SET username=? WHERE tg_id=?",
                      (msg.from_user.username or "", msg.from_user.id))
        u["username"] = msg.from_user.username or ""
    return u, is_admin(msg.from_user)


async def check_access(msg: Message) -> bool:
    """Проверка блокировки/лицензии. Если нет доступа — пишет сообщение и возвращает False."""
    u = await get_user(msg.from_user.id)
    if not u:
        return True
    if is_blocked(u):
        dt = parse_dt(u["blocked_until"])
        until = "навсегда" if dt and dt.year >= 9999 else dt.strftime("%d.%m.%Y %H:%M МСК")
        await msg.answer(
            f"🚫 <b>Вы заблокированы.</b>\n"
            f"Причина: {u.get('block_reason') or '—'}\n"
            f"До: {until}"
        )
        return False
    if is_admin(msg.from_user):
        return True
    if not license_active(u):
        await msg.answer(
            "⏰ <b>Ваш ключ закончился.</b>\nВведите новый ключ для продолжения работы.\n\n"
            "Просто отправьте ключ сообщением."
        )
        return False
    return True


def main_menu_kb(admin=False):
    kb = [
        [KeyboardButton(text="🧮 Решить пример")],
        [KeyboardButton(text="✍️ Сочинение"), KeyboardButton(text="🌐 Переводчик")],
        [KeyboardButton(text="🔤 Транслит")],
    ]
    if admin:
        kb.append([KeyboardButton(text="⚙️ Админ-панель")])
    return ReplyKeyboardMarkup(keyboard=kb, resize_keyboard=True)


def back_kb():
    return ReplyKeyboardMarkup(
        keyboard=[[KeyboardButton(text="🔙 Назад")]], resize_keyboard=True
    )


async def ask_ai(system: str, user_text: str) -> str:
    r = await gpt.chat.completions.create(
        model="gpt-4o-mini",
        messages=[
            {"role": "system", "content": system},
            {"role": "user", "content": user_text},
        ],
        temperature=0.4,
    )
    return r.choices[0].message.content


async def ask_ai_vision(system: str, prompt: str, image_bytes: bytes) -> str:
    b64 = base64.b64encode(image_bytes).decode()
    r = await gpt.chat.completions.create(
        model="gpt-4o-mini",
        messages=[
            {"role": "system", "content": system},
            {
                "role": "user",
                "content": [
                    {"type": "text", "text": prompt},
                    {"type": "image_url",
                     "image_url": {"url": f"data:image/jpeg;base64,{b64}"}},
                ],
            },
        ],
        temperature=0.3,
    )
    return r.choices[0].message.content


async def download_photo(msg: Message) -> bytes:
    file = await bot.get_file(msg.photo[-1].file_id)
    buf = io.BytesIO()
    await bot.download_file(file.file_path, buf)
    return buf.getvalue()


async def charge_tokens(msg: Message, cost: int) -> bool:
    """Списывает токены. False — если не хватило."""
    u = await get_user(msg.from_user.id)
    if not u:
        return True
    if is_admin(msg.from_user):
        return True
    if u["tokens"] < cost:
        await msg.answer(
            "💸 <b>Ваши токены закончились.</b>\n"
            f"Нужно: {cost}, у вас: {u['tokens']}.\n"
            "Они обновятся завтра в 00:00 МСК. Ожидайте."
        )
        return False
    new = u["tokens"] - cost
    await db_exec("UPDATE users SET tokens=? WHERE tg_id=?", (new, msg.from_user.id))
    u["tokens"] = new
    return True


async def show_balance(msg: Message, cost: int):
    u = await get_user(msg.from_user.id)
    if not u or is_admin(msg.from_user):
        return
    await msg.answer(
        f"<i>Списано {cost} токенов. Осталось {u['tokens']}/{u['token_limit']}.</i>"
    )


