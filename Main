# ================== MATH ==================
MATH_SYS = (
    "Ты — учитель математики. Решай примеры как школьный учитель на доске: подробно, по действиям, "
    "с пояснением правил (порядок действий, скобки, умножение/деление до сложения/вычитания, дроби, "
    "проценты, остаток от деления). Если это задача — оформи как 'Дано / Решение / Ответ'. "
    "Пиши на русском, без LaTeX, обычным текстом."
)

VISION_EXTRACT = (
    "Извлеки математическое выражение или текст задачи с картинки. "
    "Верни ТОЛЬКО распознанный пример одной строкой, без решений. "
    "Если распознать невозможно — верни ровно: НЕ РАСПОЗНАНО"
)


@router.message(S.math_wait, F.photo)
async def math_photo(msg: Message, state: FSMContext):
    if not await check_access(msg):
        return
    status = await msg.answer("🔍 Распознаю...")
    try:
        img = await download_photo(msg)
        expr = (await ask_ai_vision(
            "Ты OCR-модуль для математики.", VISION_EXTRACT, img
        )).strip()
    except Exception as e:
        await status.edit_text(f"⚠️ Ошибка распознавания: {e}")
        return

    if not expr or "НЕ РАСПОЗНАНО" in expr.upper():
        await status.edit_text("😕 Не смог разобрать. Пришлите более чёткое фото или введите текстом.")
        return

    await state.update_data(expr=expr)
    await state.set_state(S.math_confirm)
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="✅ Да", callback_data="math_yes"),
         InlineKeyboardButton(text="✏️ Изменить", callback_data="math_edit")],
    ])
    await status.edit_text(
        f"👀 Я вижу:\n<code>{expr}</code>\n\nЭто верно?",
        reply_markup=kb,
    )


@router.message(S.math_wait, F.text)
async def math_text(msg: Message, state: FSMContext):
    if not await check_access(msg):
        return
    if not await charge_tokens(msg, COST_MATH):
        return
    status = await msg.answer("🧠 Решаю...")
    try:
        ans = await ask_ai(MATH_SYS, msg.text)
    except Exception as e:
        await status.edit_text(f"⚠️ Ошибка: {e}")
        return
    await status.edit_text(f"📝 <b>Решение:</b>\n\n{ans}")
    await show_balance(msg, COST_MATH)


@router.callback_query(F.data == "math_yes", S.math_confirm)
async def math_confirm_yes(cb: CallbackQuery, state: FSMContext):
    data = await state.get_data()
    expr = data.get("expr", "")
    if not await charge_tokens(cb.message, COST_MATH_PHOTO):
        await state.clear()
        return
    await cb.message.edit_text("🧠 Решаю...")
    try:
        ans = await ask_ai(MATH_SYS, expr)
    except Exception as e:
        await cb.message.edit_text(f"⚠️ Ошибка: {e}")
        return
    await cb.message.edit_text(f"📝 <b>Решение:</b>\n\n{ans}")
    await show_balance(cb.message, COST_MATH_PHOTO)
    await state.clear()


@router.callback_query(F.data == "math_edit", S.math_confirm)
async def math_confirm_edit(cb: CallbackQuery, state: FSMContext):
    await state.set_state(S.math_wait)
    await cb.message.edit_text("✏️ Пришлите новое фото или введите пример текстом.")
    await cb.answer()


# ================== ESSAY ==================
@router.message(S.essay_topic, F.text)
async def essay_topic(msg: Message, state: FSMContext):
    if msg.text == "🔙 Назад":
        return await back_handler(msg, state)
    if not await check_access(msg):
        return
    await state.update_data(topic=msg.text)
    await state.set_state(S.essay_sentences)
    await msg.answer("Сколько предложений должно быть? (введите число)")


@router.message(S.essay_sentences, F.text)
async def essay_sentences(msg: Message, state: FSMContext):
    if msg.text == "🔙 Назад":
        return await back_handler(msg, state)
    if not msg.text.isdigit() or not (1 <= int(msg.text) <= 200):
        await msg.answer("❗ Введите число от 1 до 200.")
        return
    await state.update_data(n=int(msg.text))
    await state.set_state(S.essay_style)
    await msg.answer(
        "Какой стиль?\n"
        "<b>1</b> — умный (богатый литературный язык)\n"
        "<b>2</b> — простой (обычные, живые слова)"
    )


@router.message(S.essay_style, F.text)
async def essay_style(msg: Message, state: FSMContext):
    if msg.text == "🔙 Назад":
        return await back_handler(msg, state)
    if msg.text not in ("1", "2"):
        await msg.answer("Введите 1 или 2.")
        return
    if not await check_access(msg):
        return

    data = await state.get_data()
    topic = data["topic"]
    n = data["n"]
    style = "литературный, богатый, с умными формулировками" if msg.text == "1" \
        else "простой, естественный, как пишет обычный школьник"

    if not await charge_tokens(msg, COST_ESSAY):
        return

    status = await msg.answer("✍️ Пишу...")
    sys = (
        "Ты пишешь школьные сочинения на русском языке. "
        f"Стиль: {style}. Ровно {n} предложений. "
        "Не используй LaTeX и markdown. Просто текст. "
        "Не пиши 'вот сочинение' — сразу текст."
    )
    try:
        text = await ask_ai(sys, f"Тема: {topic}")
    except Exception as e:
        await status.edit_text(f"⚠️ Ошибка: {e}")
        return
    await status.edit_text(f"📄 <b>Сочинение на тему «{topic}»:</b>\n\n{text}")
    await show_balance(msg, COST_ESSAY)
    await state.clear()


