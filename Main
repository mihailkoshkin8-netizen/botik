def tr_target_kb():
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="🇷🇺 Русский", callback_data="tr:Русский"),
         InlineKeyboardButton(text="🇬🇧 English", callback_data="tr:English")],
        [InlineKeyboardButton(text="🇩🇪 Deutsch", callback_data="tr:Deutsch"),
         InlineKeyboardButton(text="🇫🇷 Français", callback_data="tr:Français")],
        [InlineKeyboardButton(text="🇪🇸 Español", callback_data="tr:Español"),
         InlineKeyboardButton(text="🇨🇳 中文", callback_data="tr:Китайский")],
    ])


@router.callback_query(F.data.startswith("tr:"), S.tr_target)
async def tr_do(cb: CallbackQuery, state: FSMContext):
    target = cb.data.split(":", 1)[1]
    data = await state.get_data()
    text = data.get("text", "")

    if not await charge_tokens(cb.message, COST_TRANSLATE):
        await state.clear()
        return

    await cb.message.edit_text("🌐 Перевожу...")
    try:
        res = await ask_ai(
            f"Ты профессиональный переводчик. Переведи текст на {target}. "
            "Верни ТОЛЬКО перевод, без пояснений.",
            text,
        )
    except Exception as e:
        await cb.message.edit_text(f"⚠️ Ошибка: {e}")
        return
    await cb.message.edit_text(f"🌐 <b>{target}:</b>\n\n{res}")
    await show_balance(cb.message, COST_TRANSLATE)
    await state.clear()


# ================== TRANSLIT ==================
@router.message(S.tl_input, F.text)
async def tl_do(msg: Message, state: FSMContext):
    if msg.text == "🔙 Назад":
        return await back_handler(msg, state)
    if not await check_access(msg):
        return
    await msg.answer(f"🔤 <code>{translit(msg.text)}</code>\n\n<i>Бесплатно.</i>")


# ================== ADMIN PANEL ==================
def admin_kb():
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="👥 Пользователи", callback_data="a:users")],
        [InlineKeyboardButton(text="🔑 Управление ключами", callback_data="a:keys")],
        [InlineKeyboardButton(text="⏱ Часы лицензии", callback_data="a:hours")],
        [InlineKeyboardButton(text="🗑 Удалить лицензию", callback_data="a:dellic")],
        [InlineKeyboardButton(text="🚫 Блок / Разблок", callback_data="a:block")],
        [InlineKeyboardButton(text="💎 Токены", callback_data="a:tokens")],
        [InlineKeyboardButton(text="📊 Лимит токенов", callback_data="a:limit")],
    ])


@router.callback_query(F.data == "a:users")
async def a_users(cb: CallbackQuery):
    if not is_admin(cb.from_user):
        return
    users = await db_fetchall("SELECT * FROM users ORDER BY created_at DESC")
    if not users:
        await cb.message.edit_text("Пусто.")
        return
    lines = ["<b>ID | @user | HWID | Лицензия | Токены | Блок</b>"]
    for u in users[:80]:
        lic = parse_dt(u["license_until"])
        lic_s = lic.astimezone(MSK).strftime("%d.%m %H:%M") if lic else "нет"
        blk = "да" if is_blocked(u) else "—"
        lines.append(
            f"<code>{u['tg_id']}</code> | @{u['username'] or '—'} | "
            f"<code>{u['hwid']}</code> | {lic_s} | "
            f"{u['tokens']}/{u['token_limit']} | {blk}"
        )
    text = "\n".join(lines)
    if len(text) > 4000:
        text = text[:4000] + "\n…"
    await cb.message.edit_text(text, reply_markup=admin_kb())


