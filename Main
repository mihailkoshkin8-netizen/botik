        return
    await state.set_state(S.a_hours_hwid)
    await cb.message.edit_text("Введите HWID пользователя:")


@router.message(S.a_hours_hwid, F.text)
async def a_hours_hwid(msg: Message, state: FSMContext):
    u = await get_user_by_hwid(msg.text.strip())
    if not u:
        await msg.answer("Пользователь с таким HWID не найден.")
        return
    await state.update_data(hwid=u["hwid"])
    await state.set_state(S.a_hours_act)
    await msg.answer("Что сделать? Напишите <b>+</b> (добавить) или <b>-</b> (убрать).")


@router.message(S.a_hours_act, F.text)
async def a_hours_act(msg: Message, state: FSMContext):
    if msg.text.strip() not in ("+", "-"):
        await msg.answer("Введите + или -")
        return
    await state.update_data(act=msg.text.strip())
    await state.set_state(S.a_hours_amt)
    await msg.answer("Сколько часов?")


@router.message(S.a_hours_amt, F.text)
async def a_hours_amt(msg: Message, state: FSMContext):
    if not msg.text.isdigit():
        await msg.answer("Введите число.")
        return
    d = await state.get_data()
    u = await get_user_by_hwid(d["hwid"])
    now = datetime.now(timezone.utc)
    cur = parse_dt(u["license_until"]) or now
    if cur < now:
        cur = now
    hours = int(msg.text)
    new_dt = cur + timedelta(hours=hours) if d["act"] == "+" else cur - timedelta(hours=hours)
    await db_exec("UPDATE users SET license_until=? WHERE hwid=?", (new_dt.isoformat(), d["hwid"]))
    await state.clear()
    await msg.answer(
        f"✅ Обновлено. Лицензия до: {new_dt.astimezone(MSK).strftime('%d.%m.%Y %H:%M МСК')}",
        reply_markup=main_menu_kb(True),
    )


