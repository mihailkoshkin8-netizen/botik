# ================== BACKGROUND ==================
async def daily_reset():
    """Каждые сутки в 00:00 МСК — обнуляем токены до лимита."""
    while True:
        now = datetime.now(MSK)
        nxt = (now + timedelta(days=1)).replace(hour=0, minute=0, second=0, microsecond=0)
        await asyncio.sleep((nxt - now).total_seconds())
        users = await db_fetchall("SELECT * FROM users")
        for u in users:
            limit = u["token_limit"]
            until = parse_dt(u["token_limit_until"])
            if until and until < datetime.now(timezone.utc):
                limit = DEFAULT_TOKEN_LIMIT
            await db_exec(
                "UPDATE users SET tokens=?, token_limit=?, last_reset=? WHERE tg_id=?",
                (limit, limit, datetime.now(MSK).date().isoformat(), u["tg_id"]),
            )


async def license_watcher():
    """Каждую минуту проверяем истечение лицензий (оповещаем при следующем действии — здесь просто лог)."""
    while True:
        await asyncio.sleep(60)
        # Логика оповещения реализована через check_access при любом действии.
        # Здесь можно добавить рассылку, если нужно — оставлено пустым по умолчанию.


# ================== MAIN ==================
async def main():
    await init_db()
    asyncio.create_task(daily_reset())
    asyncio.create_task(license_watcher())
    print("🤖 Бот запущен")
    await dp.start_polling(bot)


if __name__ == "__main__":
    asyncio.run(main())
