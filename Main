# ================== TRANSLIT ==================
TR = {
    'а':'a','б':'b','в':'v','г':'g','д':'d','е':'e','ё':'e','ж':'zh','з':'z',
    'и':'i','й':'y','к':'k','л':'l','м':'m','н':'n','о':'o','п':'p','р':'r',
    'с':'s','т':'t','у':'u','ф':'f','х':'kh','ц':'ts','ч':'ch','ш':'sh',
    'щ':'shch','ъ':'','ы':'y','ь':'','э':'e','ю':'yu','я':'ya',
    'А':'A','Б':'B','В':'V','Г':'G','Д':'D','Е':'E','Ё':'E','Ж':'Zh','З':'Z',
    'И':'I','Й':'Y','К':'K','Л':'L','М':'M','Н':'N','О':'O','П':'P','Р':'R',
    'С':'S','Т':'T','У':'U','Ф':'F','Х':'Kh','Ц':'Ts','Ч':'Ch','Ш':'Sh',
    'Щ':'Shch','Ъ':'','Ы':'Y','Ь':'','Э':'E','Ю':'Yu','Я':'Ya',
}


def translit(text: str) -> str:
    return "".join(TR.get(ch, ch) for ch in text)


# ================== /start ==================
@router.message(CommandStart())
async def cmd_start(msg: Message, state: FSMContext):
    await state.clear()
    u, adm = await ensure_user(msg)

    if is_blocked(u):
        dt = parse_dt(u["blocked_until"])
        until = "навсегда" if dt and dt.year >= 9999 else dt.strftime("%d.%m.%Y %H:%M МСК")
        await msg.answer(
            f"🚫 <b>Вы заблокированы.</b>\nПричина: {u.get('block_reason') or '—'}\nДо: {until}"
        )
        return

    if adm:
        await msg.answer("👑 Добро пожаловать, администратор!", reply_markup=main_menu_kb(True))
        return

    if not license_active(u):
        await msg.answer(
            "🔑 <b>Перед началом работы введите ключ активации.</b>\n\n"
            "Если у вас нет ключа — обратитесь к администратору.",
            reply_markup=ReplyKeyboardRemove(),
        )
        await state.set_state(S.key_input)
        return

    await msg.answer("👋 Главное меню:", reply_markup=main_menu_kb(False))


@router.message(Command("menu"))
async def cmd_menu(msg: Message, state: FSMContext):
    await state.clear()
    await cmd_start(msg, state)


# ================== KEY INPUT ==================
@router.message(S.key_input)
async def handle_key(msg: Message, state: FSMContext):
    key = (msg.text or "").strip()
    k = await db_fetch("SELECT * FROM keys WHERE key=?", (key,))
    if not k or k["activations_left"] <= 0:
        await msg.answer("❌ Неверный или исчерпанный ключ. Попробуйте другой.")
        return

    u = await get_user(msg.from_user.id)
    now = datetime.now(timezone.utc)
    cur = parse_dt(u["license_until"])
    base = cur if (cur and cur > now) else now
    new_until = base + timedelta(hours=k["duration_hours"])

    await db_exec("UPDATE users SET license_until=? WHERE tg_id=?",
                  (new_until.isoformat(), msg.from_user.id))
    new_left = k["activations_left"] - 1
    if new_left <= 0:
        await db_exec("DELETE FROM keys WHERE key=?", (key,))
    else:
        await db_exec("UPDATE keys SET activations_left=? WHERE key=?", (new_left, key))

    await state.clear()
    await msg.answer(
        f"✅ Ключ активирован!\nЛицензия до: {new_until.astimezone(MSK).strftime('%d.%m.%Y %H:%M МСК')}",
        reply_markup=main_menu_kb(is_admin(msg.from_user)),
    )


