@router.message(S.a_key_act, F.text)
async def a_key_act(msg: Message, state: FSMContext):
    if not msg.text.isdigit() or int(msg.text) < 1:
        await msg.answer("Введите положительное число.")
        return
    await state.update_data(act=int(msg.text))
    await state.set_state(S.a_key_dur)
    await msg.answer("На сколько часов даёт лицензию? (число)")


@router.message(S.a_key_dur, F.text)
async def a_key_dur(msg: Message, state: FSMContext):
    if not msg.text.isdigit() or int(msg.text) < 1:
        await msg.answer("Введите положительное число.")
        return
    d = await state.get_data()
    key = gen_key()
    await db_exec(
        "INSERT INTO keys(key, activations_left, duration_hours, created_at) VALUES(?,?,?,?)",
        (key, d["act"], int(msg.text), datetime.now(timezone.utc).isoformat()),
    )
    await state.clear()
    await msg.answer(
        f"✅ Ключ создан:\n<code>{key}</code>\n"
        f"Активаций: {d['act']}\nЧасов: {msg.text}",
        reply_markup=main_menu_kb(True),
    )


@router.callback_query(F.data == "a:key_list")
async def a_key_list(cb: CallbackQuery):
    if not is_admin(cb.from_user):
        return
    keys = await db_fetchall("SELECT * FROM keys ORDER BY created_at DESC")
    if not keys:
        await cb.message.edit_text("Ключей нет.", reply_markup=admin_kb())
        return
    txt = "\n".join(f"<code>{k['key']}</code> — {k['activations_left']} акт., {k['duration_hours']}ч"
                    for k in keys[:50])
    await cb.message.edit_text(f"🔑 Ключи:\n{txt}", reply_markup=admin_kb())


