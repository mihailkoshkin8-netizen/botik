        return
    await state.update_data(hwid=u["hwid"])
    await state.set_state(S.a_tokens_act)
    await msg.answer("Что сделать? <b>+</b> / <b>-</b>")


@router.message(S.a_tokens_act, F.text)
async def a_tokens_act(msg: Message, state: FSMContext):
    if msg.text.strip() not in ("+", "-"):
        await msg.answer("Введите + или -")
        return
    await state.update_data(act=msg.text.strip())
    await state.set_state(S.a_tokens_amt)
    await msg.answer("Сколько токенов? (или <b>inf</b>)")


@router.message(S.a_tokens_amt, F.text)
async def a_tokens_amt(msg: Message, state: FSMContext):
    t = msg.text.strip().lower()
    if t == "inf":
        await state.update_data(amt=10**9, inf=True)
    elif t.isdigit():
        await state.update_data(amt=int(t), inf=False)
    else:
        await msg.answer("Число или inf")
        return
    await state.set_state(S.a_tokens_days)
    await msg.answer("На сколько дней? (число или <b>inf</b>)")


@router.message(S.a_tokens_days, F.text)
async def a_tokens_days(msg: Message, state: FSMContext):
    t = msg.text.strip().lower()
    if t == "inf":
        days = 9999
    elif t.isdigit():
        days = int(t)
    else:
        await msg.answer("Число или inf")
        return

    d = await state.get_data()
    u = await get_user_by_hwid(d["hwid"])
    amt = d["amt"]
    new_val = u["tokens"] + amt if d["act"] == "+" else max(0, u["tokens"] - amt)
    if new_val > 10**9:
        new_val = 10**9
    await db_exec("UPDATE users SET tokens=? WHERE hwid=?", (new_val, d["hwid"]))
    await state.clear()
    await msg.answer(f"✅ Токенов у пользователя: {new_val} (действует {days} дн.)",
                     reply_markup=main_menu_kb(True))


