        await msg.answer("Не найдено.")
        return
    await state.update_data(hwid=msg.text.strip())
    await state.set_state(S.a_block_dur)
    await msg.answer("На сколько часов? (или напишите <b>inf</b> — навсегда)")


@router.message(S.a_block_dur, F.text)
async def a_block_dur(msg: Message, state: FSMContext):
    t = msg.text.strip().lower()
    if t == "inf":
        until = INF_DATE
    elif t.isdigit():
        until = datetime.now(timezone.utc) + timedelta(hours=int(t))
    else:
        await msg.answer("Введите число или inf")
        return
    await state.update_data(until=until.isoformat())
    await state.set_state(S.a_block_reason)
    await msg.answer("Причина блокировки:")


@router.message(S.a_block_reason, F.text)
async def a_block_reason(msg: Message, state: FSMContext):
    d = await state.get_data()
    await db_exec("UPDATE users SET blocked_until=?, block_reason=? WHERE hwid=?",
                  (d["until"], msg.text, d["hwid"]))
    await state.clear()
    await msg.answer("🚫 Заблокирован.", reply_markup=main_menu_kb(True))


